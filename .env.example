# Copy to `.env` at the repository root to override per-run settings locally.
#
# `.env` must be a FILE. If a directory of that name exists, pydantic-settings
# finds no file to read and every value below silently falls back to its default
# in src/config.py -- with no error.
#
# Every variable here is optional; the defaults in src/config.py are what a plain
# `python -m src.model.train` uses. Only RUN_ID really wants setting per run,
# since checkpoints, logs and TensorBoard scalars are all namespaced by it.

# Separates one run's artefacts from another's.
RUN_ID=local

# Where checkpoints and logs are written. Default to <repo>/data/{models,logs}.
# MODEL_DIR=/data/models
# LOG_DIR=/data/logs

# "alphazero" (real simulator in the tree) or "muzero" (learned model).
# SEARCH_MODE=alphazero

# TRAINING_EPISODES=100000
# NUM_ACTORS=1
# TOTAL_MCTS_EPISODES=800
# TRAIN_STEPS_PER_EPISODE=40
# SAVE_BEST_ONLY=true
# CHECKPOINT_WARMUP_EPISODES=50
# REANALYSE_FRACTION=0.0
